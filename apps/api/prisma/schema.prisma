generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  password  String
  name      String
  createdAt DateTime      @default(now())
  boards    BoardMember[]
}

model BoardMember {
  id      String @id @default(uuid())
  userId  String
  boardId String
  role    String @default("member") 
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId]) 
}

model Board {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  columns   Column[]
  members   BoardMember[]
}

model Column {
  id      String @id @default(uuid())
  name    String
  order   Int
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id       String @id @default(uuid())
  text     String
  order    Int
  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}