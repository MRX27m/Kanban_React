generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/columns-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./columns.db"
}

// columns-service відповідає за колонки
// BoardRef — мінімальний контекст про дошку
model BoardRef {
  id      String   @id // той самий id що і в boards-service
  columns Column[]
}

model Column {
  id      String    @id @default(uuid())
  name    String
  order   Int
  boardId String
  board   BoardRef  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   TaskRef[]
}

// TaskRef — мінімальний контекст про таски (для зв'язку)
model TaskRef {
  id       String @id // той самий id що і в tasks-service
  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}
