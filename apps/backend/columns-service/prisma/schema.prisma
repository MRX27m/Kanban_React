generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./columns.db"
}

model BoardRef {
  id      String   @id
  columns Column[]
}

model Column {
  id      String   @id @default(uuid())
  name    String
  order   Int
  boardId String
  board   BoardRef @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   TaskRef[]
}

model TaskRef {
  id       String @id
  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}
