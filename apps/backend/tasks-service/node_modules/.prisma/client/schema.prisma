generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./tasks.db"
}

// tasks-service відповідає тільки за таски
// ColumnRef — мінімальний контекст про колонку
model ColumnRef {
  id    String @id // той самий id що і в columns-service
  tasks Task[]
}

model Task {
  id       String    @id @default(uuid())
  text     String
  order    Int
  columnId String
  column   ColumnRef @relation(fields: [columnId], references: [id], onDelete: Cascade)
}
